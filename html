                        <input type="tel" id="input-wa" required placeholder="081234..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500">
                    </div>
                    <div class="bg-amber-50 border border-amber-200 rounded-xl p-3.5 mb-4 text-[11px] space-y-1 text-amber-900">
                        <p class="font-bold flex items-center gap-1"><i class="fa-solid fa-info-circle"></i> Sistem Split QRIS Otomatis:</p>
                        <p>• Toast ➔ QRIS A<br>• Gorengan ➔ QRIS B<br>• Minuman ➔ QRIS C</p>
                    </div>
                    <button type="submit" class="w-full bg-brand-500 hover:bg-brand-600 text-white font-bold py-3 rounded-xl shadow-md text-xs uppercase tracking-wider">
