                </button>
                <button onclick="toggleCart()" class="relative p-2 text-slate-700 hover:text-brand-600 transition-colors bg-slate-100 rounded-xl w-10 h-10 flex items-center justify-center border border-slate-200 shadow-sm">
                    <i class="fa-solid fa-basket-shopping text-sm"></i>
