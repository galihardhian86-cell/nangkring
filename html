<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Angkringan Nusantara - Pesan Online</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'] },
                    colors: {
                        brand: {
                            50: '#fffbeb', 100: '#fef3c7', 200: '#fde68a',
                            300: '#fcd34d', 400: '#fbbf24', 500: '#f59e0b',
                            600: '#d97706', 700: '#b45309',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #f8fafc; overflow-x: hidden; }
        .modal-enter { opacity: 0; transform: scale(0.95); pointer-events: none; }
        .modal-active { opacity: 1; transform: scale(1); pointer-events: auto; }
        .sidebar-enter { transform: translateX(100%); }
        .sidebar-active { transform: translateX(0); }
        .overlay-enter { opacity: 0; pointer-events: none; }
        .overlay-active { opacity: 1; pointer-events: auto; }
        .custom-scroll::-webkit-scrollbar { width: 4px; }
        .custom-scroll::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 20px; }
        
        .timeline-step { position: relative; padding-left: 32px; padding-bottom: 28px; border-left: 2px solid #cbd5e1; transition: all 0.3s ease; }
        .timeline-step:last-child { border-left-color: transparent; padding-bottom: 0; }
        .timeline-step::before {
            content: ''; position: absolute; left: -10px; top: 0; width: 18px; height: 18px; border-radius: 50%;
            background-color: #cbd5e1; border: 3px solid #ffffff; transition: all 0.3s ease;
        }
        .timeline-step.active::before { background-color: #f59e0b; box-shadow: 0 0 0 5px rgba(245, 158, 11, 0.2); }
        .timeline-step.active { border-left-color: #f59e0b; }
        .timeline-step.completed::before { background-color: #10b981; }
        .timeline-step.completed { border-left-color: #10b981; }
        
        @keyframes pulse-ring {
            0% { transform: scale(0.95); opacity: 0.8; }
            50% { transform: scale(1.05); opacity: 1; }
            100% { transform: scale(0.95); opacity: 0.8; }
        }
        .pulse-badge { animation: pulse-ring 2s infinite ease-in-out; }
    </style>
</head>
<body class="text-slate-800 antialiased min-h-screen flex flex-col">

    <!-- Navbar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
        <div class="max-w-3xl mx-auto px-4 h-16 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="w-10 h-10 bg-brand-500 rounded-2xl flex items-center justify-center text-white shadow-md shadow-brand-500/20">
                    <i class="fa-solid fa-fire text-base"></i>
                </div>
                <div>
                    <h1 class="font-extrabold text-base text-slate-900 tracking-tight leading-none">Angkringan<span class="text-brand-500">.</span></h1>
                    <span class="text-[10px] text-slate-400 font-semibold tracking-wider uppercase">Pesan Online Cepat</span>
                </div>
            </div>
            
            <div class="flex items-center gap-2">
                <button onclick="openSheetsConfigModal()" class="p-2 text-slate-600 hover:text-emerald-600 transition-colors bg-slate-100 hover:bg-emerald-50 rounded-xl w-10 h-10 flex items-center justify-center border border-slate-200 shadow-sm text-xs" title="Pengaturan Google Sheets">
