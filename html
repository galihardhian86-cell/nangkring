                    Simulasi verifikasi otomatis dalam <span id="qris-countdown">5</span> detik...
                </div>
                <div id="qris-container" class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-60 overflow-y-auto custom-scroll"></div>
            </div>
        </div>
    </div>

    <!-- Modal Google Sheets Config -->
    <div id="sheets-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 modal-enter transition-all duration-300 pointer-events-none">
        <div class="bg-white w-full max-w-md rounded-3xl overflow-hidden shadow-2xl flex flex-col">
            <div class="p-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
                <h3 class="font-extrabold text-slate-900 text-sm flex items-center gap-2">
                    <i class="fa-solid fa-file-excel text-emerald-600"></i> Pengaturan Google Sheets
                </h3>
                <button onclick="closeModal('sheets-modal')" class="w-8 h-8 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="p-5 space-y-4">
                <p class="text-xs text-slate-600 leading-relaxed">
                    Masukkan URL Web App Google Apps Script Anda agar setiap pesanan pelanggan otomatis tercatat di Google Spreadsheet Anda.
                </p>
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Google Apps Script Web App URL</label>
                    <input type="text" id="sheets-url-input" placeholder="https://script.google.com/macros/s/.../exec" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500 font-mono">
                </div>
                <div class="flex gap-2 pt-2">
                    <button onclick="saveSheetsUrl()" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 rounded-xl text-xs shadow-sm">
                        Simpan URL
                    </button>
                    <button onclick="testSheetsSync()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold px-4 py-2.5 rounded-xl text-xs">
                        Test Kirim
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, setDoc, deleteDoc, onSnapshot, collection, getDocs } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        const appId = typeof __app_id !== 'undefined' ? __app_id : 'angkringan-customer-app';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : { apiKey: "demo", authDomain: "demo.firebaseapp.com", projectId: "demo" };

        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);
        const auth = getAuth(app);

        let menuData = [];
        let ordersList = [];
        let cart = {};
        let activeOrder = null;
        let simInterval = null;
        let clockInterval = null;
        let alarmInterval = null;
        let googleSheetsUrl = localStorage.getItem('angkringan_sheets_url') || '';

        const formatRp = (val) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(val);

        function playNotificationSound() {
            try {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const playTone = (freq, delay, duration) => {
                    setTimeout(() => {
                        if (audioCtx.state === 'suspended') audioCtx.resume();
                        const osc = audioCtx.createOscillator();
                        const gain = audioCtx.createGain();
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
                        gain.gain.setValueAtTime(0.4, audioCtx.currentTime);
                        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
                        osc.connect(gain);
                        gain.connect(audioCtx.destination);
                        osc.start();
                        osc.stop(audioCtx.currentTime + duration);
                    }, delay);
                };
                playTone(587.33, 0, 0.3); 
                playTone(880.00, 250, 0.4);
                playTone(1046.50, 500, 0.5);
                if (navigator.vibrate) navigator.vibrate([300, 100, 300, 100, 400]);
            } catch (e) {
                console.log("Audio not supported", e);
            }
        }

        async function initFirebase() {
            try {
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }
                startRealtimeListeners();
            } catch (e) {
                console.error("Auth error:", e);
            }
        }

        async function seedMenuIfNeeded() {
            const menuRef = collection(db, 'artifacts', appId, 'public', 'data', 'menu');
            const menuSnapshot = await getDocs(menuRef);
            if (menuSnapshot.empty) {
                const defaultMenu = [
                    { id: 1, name: 'Gorengan', price: 2000, qris: 'B', stock: 30, img: 'https://images.unsplash.com/photo-1606787366850-de6330128bfc?w=300&q=80', desc: 'Aneka gorengan hangat (bakwan, tempe, tahu).' },
                    { id: 2, name: 'Toast', price: 10000, qris: 'A', stock: 15, img: 'https://images.unsplash.com/photo-1525351484163-7529414344d8?w=300&q=80', desc: 'Roti bakar lezat isi cokelat/keju lumer.' },
                    { id: 3, name: 'Ekstra Jos Susu', price: 6000, qris: 'C', stock: 20, img: 'https://images.unsplash.com/photo-1544787219-7f47ccb76574?w=300&q=80', desc: 'Minuman penambah stamina khas.' },
                    { id: 4, name: 'Susu Jahe', price: 6000, qris: 'C', stock: 25, img: 'https://images.unsplash.com/photo-1576092768241-dec231879fc3?w=300&q=80', desc: 'Susu hangat berpadu jahe merah murni.' },
                    { id: 5, name: 'Jahe', price: 4000, qris: 'C', stock: 20, img: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=300&q=80', desc: 'Wedang jahe hangat murni menyegarkan.' },
                    { id: 6, name: 'Nutrisari', price: 5000, qris: 'C', stock: 35, img: 'https://images.unsplash.com/photo-1513558161293-cdaf765ed2fd?w=300&q=80', desc: 'Es / hangat jeruk segar kaya vitamin.' }
                ];
                for (const item of defaultMenu) {
                    await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'menu', String(item.id)), item);
                }
            }
        }

        function startRealtimeListeners() {
            seedMenuIfNeeded().then(() => {
                onSnapshot(collection(db, 'artifacts', appId, 'public', 'data', 'menu'), (snapshot) => {
                    menuData = [];
                    snapshot.forEach(docSnap => menuData.push({ docId: docSnap.id, ...docSnap.data() }));
                    menuData.sort((a, b) => a.id - b.id);
                    renderMenu();
                }, (err) => console.error("Menu listener error:", err));

                onSnapshot(collection(db, 'artifacts', appId, 'public', 'data', 'orders'), (snapshot) => {
                    ordersList = [];
                    snapshot.forEach(docSnap => ordersList.push({ docId: docSnap.id, ...docSnap.data() }));
                    ordersList.sort((a, b) => a.id - b.id);

                    if (activeOrder) {
                        const found = ordersList.find(o => o.id === activeOrder.id);
                        if (found) {
                            activeOrder.status = found.status;
                            updateCustomerTimeline(found.status);
                        }
                    }
                }, (err) => console.error("Orders listener error:", err));
            });
        }

        function renderMenu() {
            const grid = document.getElementById('menu-grid');
            if (!grid) return;
            
            grid.innerHTML = menuData.map(item => {
                const isOut = item.stock <= 0;
                return `
                    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden flex flex-col justify-between hover:shadow-md transition-all">
                        <div class="relative h-32 bg-slate-100 overflow-hidden">
                            <img src="${item.img}" alt="${item.name}" class="w-full h-full object-cover ${isOut ? 'grayscale opacity-50' : ''}" onerror="this.src='https://placehold.co/300x200/f59e0b/ffffff?text=Angkringan'">
                            <div class="absolute top-2 left-2 bg-slate-900/70 backdrop-blur-md text-white text-[9px] font-bold px-2 py-0.5 rounded-full uppercase">
                                QRIS ${item.qris}
                            </div>
                            ${isOut ? '<div class="absolute inset-0 flex items-center justify-center bg-slate-900/40 text-white font-black text-xs uppercase tracking-wider">Habis</div>' : ''}
                        </div>
                        <div class="p-3.5 flex-1 flex flex-col justify-between">
                            <div>
                                <h4 class="font-extrabold text-slate-900 text-sm mb-0.5">${item.name}</h4>
                                <p class="text-[11px] text-slate-400 line-clamp-1 mb-2">${item.desc}</p>
                            </div>
                            <div class="flex items-center justify-between mt-2 pt-2 border-t border-slate-100">
                                <div>
                                    <span class="text-[10px] text-slate-400 block leading-none">Harga</span>
                                    <span class="font-black text-brand-600 text-xs">${formatRp(item.price)}</span>
                                </div>
                                <button onclick="${isOut ? '' : `addToCart('${item.docId}')`}" class="${isOut ? 'bg-slate-200 text-slate-400 cursor-not-allowed' : 'bg-brand-500 hover:bg-brand-600 text-white shadow-sm'} w-8 h-8 rounded-xl flex items-center justify-center transition-all">
                                    <i class="fa-solid fa-plus text-xs"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        window.addToCart = function(docId) {
            const item = menuData.find(m => m.docId === docId);
            if (!item || item.stock <= 0) return;

            if (!cart[docId]) {
                cart[docId] = { ...item, qty: 1 };
            } else {
                if (cart[docId].qty < item.stock) {
                    cart[docId].qty++;
                } else {
                    return;
                }
            }
            updateCartUI();
            window.toggleCart(true);
        };

        window.updateCartQty = function(docId, delta) {
            if (!cart[docId]) return;
            cart[docId].qty += delta;
            if (cart[docId].qty <= 0) delete cart[docId];
            updateCartUI();
        };

        function updateCartUI() {
            const container = document.getElementById('cart-items-container');
            const badge = document.getElementById('cart-badge');
            const footer = document.getElementById('cart-footer');
            const totalPriceEl = document.getElementById('cart-total-price');
            
            const entries = Object.values(cart);
            const totalItems = entries.reduce((acc, curr) => acc + curr.qty, 0);
            const totalPrice = entries.reduce((acc, curr) => acc + (curr.price * curr.qty), 0);

            if (totalItems > 0) {
                badge.textContent = totalItems;
                badge.classList.remove('hidden');
                footer.classList.remove('hidden');
                totalPriceEl.textContent = formatRp(totalPrice);
                
                container.innerHTML = entries.map(item => `
                    <div class="flex items-center justify-between bg-slate-50 border border-slate-100 p-2.5 rounded-xl">
                        <div class="flex items-center gap-2.5">
                            <img src="${item.img}" class="w-10 h-10 rounded-lg object-cover" onerror="this.src='https://placehold.co/100x100/f59e0b/ffffff?text=Food'">
                            <div>
                                <h5 class="font-bold text-xs text-slate-900">${item.name}</h5>
                                <p class="text-[11px] text-brand-600 font-semibold">${formatRp(item.price)}</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="updateCartQty('${item.docId}', -1)" class="w-6 h-6 rounded-lg bg-white border border-slate-200 text-slate-600 flex items-center justify-center text-xs hover:bg-slate-100"><i class="fa-solid fa-minus"></i></button>
                            <span class="font-bold text-xs text-slate-800 w-4 text-center">${item.qty}</span>
                            <button onclick="updateCartQty('${item.docId}', 1)" class="w-6 h-6 rounded-lg bg-white border border-slate-200 text-slate-600 flex items-center justify-center text-xs hover:bg-slate-100"><i class="fa-solid fa-plus"></i></button>
                        </div>
                    </div>
                `).join('');
            } else {
                badge.classList.add('hidden');
                footer.classList.add('hidden');
                container.innerHTML = `
                    <div id="empty-cart" class="flex flex-col items-center justify-center h-full text-slate-400 py-12">
                        <i class="fa-solid fa-bowl-food text-4xl mb-2 text-slate-300"></i>
                        <p class="text-xs font-semibold">Keranjang masih kosong</p>
                    </div>
                `;
            }
        }

        window.toggleCart = function(forceOpen = false) {
            const sidebar = document.getElementById('cart-sidebar');
            const overlay = document.getElementById('global-overlay');
            const isOpen = forceOpen || sidebar.classList.contains('sidebar-active');

            if (isOpen && !forceOpen) {
                sidebar.classList.remove('sidebar-active');
                overlay.classList.remove('overlay-active');
            } else {
                sidebar.classList.add('sidebar-active');
                overlay.classList.add('overlay-active');
            }
        };

        window.closeAllModals = function() {
            document.getElementById('cart-sidebar').classList.remove('sidebar-active');
            ['checkout-modal', 'qris-modal', 'sheets-modal'].forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    el.classList.remove('modal-active');
                    el.classList.add('pointer-events-none');
                }
            });
            document.getElementById('global-overlay').classList.remove('overlay-active');
        };

        window.closeModal = function(id) {
            const el = document.getElementById(id);
            if (el) {
                el.classList.remove('modal-active');
                el.classList.add('pointer-events-none');
            }
            document.getElementById('global-overlay').classList.add('overlay-active');
        };

        window.openCheckoutModal = function() {
            window.toggleCart();
            const modal = document.getElementById('checkout-modal');
            modal.classList.remove('pointer-events-none');
            modal.classList.add('modal-active');
            document.getElementById('global-overlay').classList.add('overlay-active');
        };

        window.openSheetsConfigModal = function() {
            document.getElementById('sheets-url-input').value = googleSheetsUrl;
            const modal = document.getElementById('sheets-modal');
            modal.classList.remove('pointer-events-none');
            modal.classList.add('modal-active');
            document.getElementById('global-overlay').classList.add('overlay-active');
        };

        window.saveSheetsUrl = function() {
            const url = document.getElementById('sheets-url-input').value.trim();
            googleSheetsUrl = url;
            localStorage.setItem('angkringan_sheets_url', url);
            window.closeModal('sheets-modal');
        };

        window.testSheetsSync = function() {
            const url = document.getElementById('sheets-url-input').value.trim();
            if (!url) {
                return;
            }
            const sample = { id: 9999, name: "Test Pelanggan", wa: "0812345", items: "Gorengan x1", total: 2000, timestamp: new Date().toLocaleString() };
            fetch(url, { method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(sample) })
            .then(() => {
                // success
            }).catch(err => console.log(err));
        };

        window.processSplitQRIS = async function(e) {
            e.preventDefault();
            const name = document.getElementById('input-name').value;
            const wa = document.getElementById('input-wa').value;

            window.closeModal('checkout-modal');

            const orderId = Math.floor(1000 + Math.random() * 9000);
            const items = JSON.parse(JSON.stringify(Object.values(cart)));
            
            const split = { A: 0, B: 0, C: 0 };
            items.forEach(i => { split[i.qris] += i.price * i.qty; });

            activeOrder = {
                id: orderId,
                name,
                wa,
                items,
                split,
                status: 1, // 1: Diterima, 2: Dimasak, 3: Siap Saji
                createdAt: new Date().toLocaleTimeString()
            };

            try {
                await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'orders', String(orderId)), activeOrder);
                syncToGoogleSheets(activeOrder);
            } catch (err) {
                console.error("Error saving order:", err);
            }

            const qrisContainer = document.getElementById('qris-container');
            qrisContainer.innerHTML = Object.entries(split).filter(([k, v]) => v > 0).map(([qrisKey, amount]) => `
                <div class="bg-white border border-slate-200 rounded-2xl p-3 text-center shadow-sm">
                    <span class="bg-brand-100 text-brand-700 font-black text-[10px] px-2 py-0.5 rounded-full uppercase">QRIS ${qrisKey}</span>
                    <div class="my-2 bg-slate-100 p-2 rounded-xl flex items-center justify-center">
                        <i class="fa-solid fa-qrcode text-4xl text-slate-800"></i>
                    </div>
                    <p class="font-black text-slate-900 text-xs">${formatRp(amount)}</p>
                </div>
            `).join('');

            const qrisModal = document.getElementById('qris-modal');
            qrisModal.classList.remove('pointer-events-none');
            qrisModal.classList.add('modal-active');
            document.getElementById('global-overlay').classList.add('overlay-active');

            let countdown = 5;
            const countEl = document.getElementById('qris-countdown');
            countEl.textContent = countdown;

            if (simInterval) clearInterval(simInterval);
            simInterval = setInterval(() => {
                countdown--;
                countEl.textContent = countdown;
                if (countdown <= 0) {
                    clearInterval(simInterval);
                    window.closeModal('qris-modal');
                    cart = {};
                    updateCartUI();
                    startLiveTracking();
                }
            }, 1000);
        };

        function startLiveTracking() {
            const liveCard = document.getElementById('live-status-card');
            liveCard.classList.remove('hidden');
            
            document.getElementById('track-order-id').textContent = activeOrder.id;
            document.getElementById('track-name').textContent = activeOrder.name;
            document.getElementById('track-wa').textContent = activeOrder.wa;

            window.scrollTo({ top: 0, behavior: 'smooth' });

            if (clockInterval) clearInterval(clockInterval);
            clockInterval = setInterval(() => {
                const now = new Date();
                document.getElementById('live-clock').textContent = now.toTimeString().split(' ')[0];
            }, 1000);

            updateCustomerTimeline(1);
        }

        function updateCustomerTimeline(step) {
            for (let i = 1; i <= 3; i++) {
                const el = document.getElementById(`step-${i}`);
                if (!el) continue;
                if (i < step) {
                    el.classList.remove('active');
                    el.classList.add('completed');
                } else if (i === step) {
                    el.classList.add('active');
                    el.classList.remove('completed');
                } else {
                    el.classList.remove('active', 'completed');
                }
            }

            const descText = document.getElementById('queue-desc-text');
            const numDisplay = document.getElementById('queue-num-display');
            const btn = document.getElementById('btn-finish-order');

            const activeQueue = ordersList.filter(o => o.status < 3);
            const myIndex = activeQueue.findIndex(o => o.id === activeOrder?.id);
            const queuePos = myIndex !== -1 ? myIndex + 1 : 1;
            const totalQueue = activeQueue.length;
            const estimatedMinutes = queuePos * 5;

            if (step === 1) {
                numDisplay.textContent = `Antrean #${queuePos} dari ${totalQueue}`;
                descText.textContent = `Estimasi waktu tunggu: ~${estimatedMinutes} menit. Menunggu konfirmasi dapur.`;
            } else if (step === 2) {
                numDisplay.textContent = `Sedang Dimasak`;
                descText.textContent = `Koki sedang meracik pesanan Anda. Segera siap!`;
            } else if (step === 3) {
                numDisplay.textContent = `Siap Saji`;
                descText.textContent = `Pesanan selesai dan siap diambil di meja utama!`;

                btn.className = "w-full bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-3 rounded-xl shadow-md cursor-pointer pointer-events-auto transition-all text-xs uppercase tracking-wider animate-bounce";
                btn.textContent = "🔔 Pesanan Siap! (Klik untuk Ambil & Selesai)";

                if (!alarmInterval) {
                    playNotificationSound();
                    alarmInterval = setInterval(() => { playNotificationSound(); }, 2500);
                }
            }
        }

        window.finishCustomerOrder = async function() {
            if (alarmInterval) {
                clearInterval(alarmInterval);
                alarmInterval = null;
            }
            if (clockInterval) clearInterval(clockInterval);

            if (activeOrder) {
                try {
                    await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'orders', String(activeOrder.id)));
                } catch (e) {
                    console.error("Error finishing order:", e);
                }
            }

            activeOrder = null;
            document.getElementById('live-status-card').classList.add('hidden');
            document.getElementById('order-form').reset();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        };

        function syncToGoogleSheets(order) {
            if (!googleSheetsUrl) return;
            const total = order.items.reduce((acc, i) => acc + (i.price * i.qty), 0);
            const itemsStr = order.items.map(i => `${i.name} (${i.qty})`).join(', ');
            const payload = {
                id: order.id,
                name: order.name,
                wa: order.wa,
                items: itemsStr,
                total: total,
                timestamp: order.createdAt
            };
            fetch(googleSheetsUrl, {
                method: 'POST',
                mode: 'no-cors',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            }).catch(err => console.log("Background sheets sync error:", err));
        }

        window.onload = () => {
            initFirebase();
        };
    </script>
</body>
</html>
